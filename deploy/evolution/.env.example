# Copie este arquivo para ".env" no servidor e preencha.

# Endereço público do servidor. Sem domínio próprio, use o IP com sslip.io, por exemplo:
#   129.146.10.20.sslip.io   (troque pelo IP público da sua máquina na Oracle)
EVOLUTION_DOMAIN=

# Chave de acesso da API. Gere uma senha longa e aleatória (ex.: openssl rand -hex 32).
# É a mesma que vai em EVOLUTION_API_KEY no Supabase.
EVOLUTION_API_KEY=

# Senha do banco interno (qualquer senha forte).
POSTGRES_PASSWORD=
